{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blablaflow",
  "version": "0.1.0",
  "identifier": "com.blablaflow.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "blablaflow", "url": "index.html", "width": 1000, "height": 700, "visible": false },
      {
        "label": "overlay", "title": "blablaflow bar", "url": "overlay.html",
        "width": 220, "height": 48, "transparent": true, "decorations": false,
        "alwaysOnTop": true, "skipTaskbar": true, "focus": false, "shadow": false,
        "resizable": false, "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
